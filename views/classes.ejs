<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Classes | MailMyWork.io</title>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-95YQNPYWYM"></script>
  <script src="/javascripts/google_analytics.js"></script>
  <link rel="stylesheet" href="/stylesheets/main.css" />
  <link rel="stylesheet" href="/stylesheets/navbar.css" />
  <link rel="manifest" href="/manifest.json" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    .classes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      width: 100%;
      margin-top: 2rem;
    }

    .class-card {
      background: var(--bg-panel);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 30px 24px;
      text-align: center;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 180px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .class-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-indigo), transparent);
      opacity: 0.7;
    }

    .class-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent-cyan);
      box-shadow: var(--glow-cyan);
    }

    .class-name {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
      letter-spacing: 0.5px;
    }

    .class-count {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      font-family: 'Outfit', sans-serif;
    }

    .class-action-btn {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid rgba(0, 240, 255, 0.2);
      background: rgba(0, 240, 255, 0.05);
      color: var(--accent-cyan);
      font-family: 'Rajdhani', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.95rem;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .class-card:hover .class-action-btn {
      background: var(--accent-cyan);
      color: #050507;
      box-shadow: var(--glow-cyan);
      border-color: var(--accent-cyan);
    }

    /* Create Class Special Card */
    .create-card {
      border: 2px dashed rgba(79, 70, 229, 0.4);
      background: rgba(79, 70, 229, 0.02);
      justify-content: center;
      align-items: center;
    }

    .create-card::after {
      display: none;
    }

    .create-card:hover {
      border-color: var(--accent-indigo);
      background: rgba(79, 70, 229, 0.05);
      box-shadow: var(--glow-indigo);
    }

    .create-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 12px;
      fill: var(--text-muted);
      transition: all 0.3s ease;
    }

    .create-card:hover .create-icon {
      fill: var(--accent-indigo);
      transform: scale(1.1);
    }

    .create-label {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .create-card:hover .create-label {
      color: #fff;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(5, 5, 7, 0.85);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      width: 90%;
      max-width: 440px;
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 35px 30px;
      position: relative;
      box-shadow: 0 20px 50px rgba(0,0,0,0.6);
      transform: translateY(30px);
      transition: transform 0.3s ease;
    }

    .modal-overlay.active .modal-box {
      transform: translateY(0);
    }

    .modal-box::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent-indigo), var(--accent-cyan), transparent);
    }

    .modal-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 20px;
      text-align: center;
      letter-spacing: 1px;
      color: #fff;
    }

    .close-modal-btn {
      position: absolute;
      top: 15px;
      right: 15px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
    }

    .close-modal-btn:hover {
      color: #ef4444;
    }

    .error-alert {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-family: 'Rajdhani', sans-serif;
      font-weight: 600;
      text-align: center;
    }
  </style>
</head>

<body>
  <!-- SVG Gradient Definition for Logo -->
  <svg style="position: absolute; width: 0; height: 0;">
    <defs>
      <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#1c55d0;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#00f0ff;stop-opacity:1" />
      </linearGradient>
    </defs>
  </svg>

  <!-- Navbar -->
  <header>
    <nav class="navbar">
      <div class="logo" onclick="window.location.href='/'" style="cursor: pointer;">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="none"
            stroke="url(#logoGradient)" stroke-width="2" />
          <path d="M22 6l-10 7L2 6" fill="none" stroke="url(#logoGradient)" stroke-width="2" />
        </svg>
        MailMyWork.io
      </div>
      <ul class="nav-links">
        <li><a href="/">Share Files</a></li>
        <li><a href="/classes" class="active">Classes</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <div class="menu-toggle" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Content -->
  <div class="container" style="max-width: 960px; margin: 8rem auto 4rem auto; padding: 45px 35px;">
    <h1 class="title" style="margin-bottom: 0.5rem;">Study Classes</h1>
    <p style="text-align:center; line-height:1.6; margin-bottom: 2rem; color:var(--text-muted); font-family:'Outfit', sans-serif;">
      Select a class to upload and share assignment documents (PDFs). Files automatically expire and delete after 7 days.
    </p>

    <% if (error) { %>
      <div class="error-alert">
        <%= error %>
      </div>
    <% } %>

    <div class="classes-grid">
      <!-- Create Class Action Card -->
      <div class="class-card create-card" id="openCreateModalBtn">
        <svg class="create-icon" viewBox="0 0 24 24">
          <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
        </svg>
        <span class="create-label">+ Create Class</span>
      </div>

      <!-- Classes Cards -->
      <% classes.forEach(cls => { %>
        <div class="class-card" onclick="window.location.href='/classes/<%= cls.code %>'">
          <div class="class-info">
            <h3 class="class-name"><%= cls.name %></h3>
            <span class="class-count"><%= cls.assignmentCount %> Document<%= cls.assignmentCount === 1 ? '' : 's' %></span>
          </div>
          <button class="class-action-btn">Enter Class</button>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Create Class Modal -->
  <div class="modal-overlay" id="createModalOverlay">
    <div class="modal-box">
      <button class="close-modal-btn" id="closeCreateModalBtn">&times;</button>
      <h2 class="modal-title">Create Class</h2>
      <form action="/classes" method="POST" style="width:100%;">
        <input type="text" name="className" placeholder="Class Name (e.g. Physics 12)" class="email-input" required autocomplete="off" />
        <button type="submit" class="submit-btn" style="margin-top: 10px;">Create</button>
      </form>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="/javascripts/navbar.js"></script>
  <script>
    // Modal controls
    const overlay = document.getElementById("createModalOverlay");
    const openBtn = document.getElementById("openCreateModalBtn");
    const closeBtn = document.getElementById("closeCreateModalBtn");

    if (openBtn) {
      openBtn.addEventListener("click", () => {
        overlay.classList.add("active");
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        overlay.classList.remove("active");
      });
    }

    if (overlay) {
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) overlay.classList.remove("active");
      });
    }

    // GSAP staggered entrance animations
    document.addEventListener("DOMContentLoaded", () => {
      gsap.fromTo(".class-card", 
        { opacity: 0, y: 30, scale: 0.95 },
        { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.08, ease: "power2.out", delay: 0.2 }
      );
    });
  </script>
</body>

</html>
