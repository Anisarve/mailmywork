<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact | MailMyWork.io</title>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-95YQNPYWYM"></script>
  <script src="/javascripts/google_analytics.js"></script>
  <!-- Link main.css since it has base container/input styles -->
  <link rel="stylesheet" href="/stylesheets/main.css" />
  <link rel="stylesheet" href="/stylesheets/navbar.css" />
  <link rel="manifest" href="/manifest.json" />
  <link
    href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap"
    rel="stylesheet">
  <style>
    .contact-card-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 1rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 16px 24px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      position: relative;
      overflow: hidden;
    }

    .contact-item:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--accent-cyan);
      box-shadow: var(--glow-cyan);
      transform: translateY(-2px);
    }

    .contact-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(0, 240, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 20px;
      flex-shrink: 0;
      color: var(--accent-cyan);
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 240, 255, 0.2);
    }

    .contact-item:hover .contact-icon {
      background: var(--accent-cyan);
      color: #050507;
      box-shadow: var(--glow-cyan);
    }

    .contact-icon svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .contact-details {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .contact-label {
      font-family: 'Rajdhani', sans-serif;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .contact-value {
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--text-main);
      font-family: 'Outfit', sans-serif;
    }

    /* Adjust static text styling */
    .contact-desc {
      text-align: center;
      line-height: 1.6;
      margin-bottom: 2rem;
      color: var(--text-muted);
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem;
    }
  </style>
</head>

<body>
  <!-- SVG Gradient Definition for Logo -->
  <svg style="position: absolute; width: 0; height: 0;">
    <defs>
      <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#1c55d0;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#00f0ff;stop-opacity:1" />
      </linearGradient>
    </defs>
  </svg>

  <!-- Navbar -->
  <header>
    <nav class="navbar">
      <div class="logo" onclick="window.location.href='/'" style="cursor: pointer;">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="none"
            stroke="url(#logoGradient)" stroke-width="2" />
          <path d="M22 6l-10 7L2 6" fill="none" stroke="url(#logoGradient)" stroke-width="2" />
        </svg>
        MailMyWork.io
      </div>
      <ul class="nav-links">
        <li><a href="/">Share Files</a></li>
        <li><a href="/contact" class="active">Contact</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <div class="menu-toggle" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Content -->
  <div class="container">
    <h1 class="title">Contact Us</h1>
    <p class="contact-desc">
      Have questions, feedback, or suggestions? Feel free to reach out to me directly through any of the channels below!
    </p>

    <div class="contact-card-list">
      <!-- Name Info (Static/Interactive info item) -->
      <div class="contact-item" style="cursor: default;">
        <div class="contact-icon">
          <!-- User Profile Icon SVG -->
          <svg viewBox="0 0 24 24">
            <path
              d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
          </svg>
        </div>
        <div class="contact-details">
          <span class="contact-label">Name</span>
          <span class="contact-value"
            style="font-family: 'Rajdhani', sans-serif; font-weight: 700; letter-spacing: 0.5px;">Anirudh Ghanshyam
            Sarve</span>
        </div>
      </div>

      <!-- Phone Info -->
      <a href="tel:9322381894" class="contact-item">
        <div class="contact-icon">
          <!-- Telephone Icon SVG -->
          <svg viewBox="0 0 24 24">
            <path
              d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
          </svg>
        </div>
        <div class="contact-details">
          <span class="contact-label">Contact No</span>
          <span class="contact-value">9322381894</span>
        </div>
      </a>

      <!-- Email Info -->
      <a href="mailto:anisarve2006@gmail.com" class="contact-item">
        <div class="contact-icon">
          <!-- Envelope Icon SVG -->
          <svg viewBox="0 0 24 24">
            <path
              d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
          </svg>
        </div>
        <div class="contact-details">
          <span class="contact-label">Email Address</span>
          <span class="contact-value">anisarve2006@gmail.com</span>
        </div>
      </a>

      <!-- LinkedIn Info -->
      <a href="https://www.linkedin.com/in/anirudh-sarve-2130a724a/" target="_blank" rel="noopener noreferrer" class="contact-item">
        <div class="contact-icon">
          <!-- LinkedIn SVG Icon -->
          <svg viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </div>
        <div class="contact-details">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-value">anirudh-sarve-2130a724a</span>
        </div>
      </a>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="/javascripts/navbar.js"></script>
  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
  </script>
</body>

</html>